# ---------------------------------------------------------------
# Copy to .env.docker and fill in. That file is gitignored.
#   docker compose --env-file .env.docker up --build
# ---------------------------------------------------------------

MYSQL_ROOT_PASSWORD=change_this_root_password
MYSQL_DATABASE=resume_analyzer
MYSQL_USER=resumeiq
MYSQL_PASSWORD=change_this_app_password

# Must be at least 32 chars; the app refuses to start otherwise.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=generate_a_long_random_value_and_paste_it_here

ENVIRONMENT=production
CORS_ORIGINS=http://localhost:5174
VITE_API_BASE_URL=http://localhost:8001/api

# Optional — leave blank to disable Google sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5174/login
