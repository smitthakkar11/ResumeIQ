# ---------------------------------------------------------------
# ResumeIQ backend configuration
# Copy this file to `.env` and fill in real values.
# `.env` is gitignored and must NEVER be committed.
# ---------------------------------------------------------------

# Application
APP_NAME=ResumeIQ
ENVIRONMENT=development
API_V1_PREFIX=/api

# MySQL connection
# Format: mysql+pymysql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=mysql+pymysql://resumeiq:CHANGE_ME@localhost:3306/resume_analyzer

# Comma-separated list of origins allowed to call this API from a browser
CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174

# ---------------------------------------------------------------
# Security / JWT
# Generate a key with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Use a DIFFERENT key per environment. Leaking this lets anyone
# forge a token for any user.
# ---------------------------------------------------------------
SECRET_KEY=replace_me_with_a_long_random_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
BCRYPT_COST=12

# ---------------------------------------------------------------
# Google OAuth 2.0 (optional — leave blank to disable Google sign-in)
# Create credentials at https://console.cloud.google.com/apis/credentials
# GOOGLE_CLIENT_SECRET must NEVER appear in the frontend.
# ---------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5174/login

# ---------------------------------------------------------------
# Match score weights. Must sum to 1.0.
#   Overall = 0.4*text similarity + 0.4*skill match + 0.2*keyword match
# ---------------------------------------------------------------
TEXT_SIMILARITY_WEIGHT=0.4
SKILL_MATCH_WEIGHT=0.4
KEYWORD_MATCH_WEIGHT=0.2
TOP_KEYWORDS=15
