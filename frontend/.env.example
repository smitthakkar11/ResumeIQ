# ---------------------------------------------------------------
# ResumeIQ frontend configuration
# Copy to `.env` — values here are BUNDLED INTO THE BROWSER BUILD.
#
# Vite only exposes variables prefixed with VITE_. That prefix is a
# security boundary: anything with it is public. Never put an API
# secret, a database password, or GOOGLE_CLIENT_SECRET in this file.
# ---------------------------------------------------------------

VITE_API_BASE_URL=http://localhost:8001/api
